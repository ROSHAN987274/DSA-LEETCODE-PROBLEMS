Question:
Given an integer array nums, find the subarray with the largest sum, and return its sum.

code used:
int maxSubArray(int* nums, int numsSize) {
    int largestSum = nums[0];
    int sum = nums[0];

    for(int i=1; i<numsSize; i++){
        if(sum +nums[i] > nums[i]){
            sum +=nums[i];
        }else{
            sum = nums[i];
        }
        if(sum> largestSum){
            largestSum = sum;
        }
    }
       
    
    return largestSum;
}

time complexity: O(n)
